!- Windows Line endings 

VERSION,
    26.1;                     !- Version Identifier

SIMULATIONCONTROL,
    Yes,                      !- Do Zone Sizing Calculation
    Yes,                      !- Do System Sizing Calculation
    No,                       !- Do Plant Sizing Calculation
    No,                       !- Run Simulation for Sizing Periods
    Yes,                      !- Run Simulation for Weather File Run Periods
    No,                       !- Do HVAC Sizing Simulation for Sizing Periods
    1;                        !- Maximum Number of HVAC Sizing Simulation Passes

BUILDING,
    0001,                     !- Name
    0,                        !- North Axis
    Suburbs,                  !- Terrain
    0.04,                     !- Loads Convergence Tolerance Value
    0.4,                      !- Temperature Convergence Tolerance Value
    FullExterior,             !- Solar Distribution
    25,                       !- Maximum Number of Warmup Days
    6;                        !- Minimum Number of Warmup Days

TIMESTEP,
    4;                        !- Number of Timesteps per Hour

RUNPERIOD,
    Annual,                   !- Name
    1,                        !- Begin Month
    1,                        !- Begin Day of Month
    ,                         !- Begin Year
    12,                       !- End Month
    31,                       !- End Day of Month
    ,                         !- End Year
    ,                         !- Day of Week for Start Day
    Yes,                      !- Use Weather File Holidays and Special Days
    Yes,                      !- Use Weather File Daylight Saving Period
    No,                       !- Apply Weekend Holiday Rule
    Yes,                      !- Use Weather File Rain Indicators
    Yes,                      !- Use Weather File Snow Indicators
    No,                       !- Treat Weather as Actual
    Hour24;                   !- First Hour Interpolation Starting Values

SCHEDULETYPELIMITS,
    Any Number,               !- Name
    ,                         !- Lower Limit Value
    ,                         !- Upper Limit Value
    ,                         !- Numeric Type
    Dimensionless;            !- Unit Type

SCHEDULETYPELIMITS,
    Fraction,                 !- Name
    0,                        !- Lower Limit Value
    1,                        !- Upper Limit Value
    Continuous,               !- Numeric Type
    Dimensionless;            !- Unit Type

SCHEDULE:CONSTANT,
    HeatingSetpointSchedule,    !- Name
    Any Number,               !- Schedule Type Limits Name
    21;                       !- Hourly Value

SCHEDULE:CONSTANT,
    CoolingSetpointSchedule,    !- Name
    Any Number,               !- Schedule Type Limits Name
    24;                       !- Hourly Value

SCHEDULE:CONSTANT,
    OccupancySchedule,        !- Name
    Fraction,                 !- Schedule Type Limits Name
    0.5;                      !- Hourly Value

SCHEDULE:CONSTANT,
    ActivityLevelSchedule,    !- Name
    Any Number,               !- Schedule Type Limits Name
    120;                      !- Hourly Value

SCHEDULE:CONSTANT,
    LightingSchedule,         !- Name
    Fraction,                 !- Schedule Type Limits Name
    0.6;                      !- Hourly Value

SCHEDULE:CONSTANT,
    EquipmentSchedule,        !- Name
    Fraction,                 !- Schedule Type Limits Name
    0.5;                      !- Hourly Value

MATERIAL,
    Wall_plaster_Mat,         !- Name
    Smooth,                   !- Roughness
    0.013,                    !- Thickness
    0.16,                     !- Conductivity
    800,                      !- Density
    1090,                     !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL,
    Roof_tile_Mat,            !- Name
    Smooth,                   !- Roughness
    0.02,                     !- Thickness
    1,                        !- Conductivity
    2000,                     !- Density
    800,                      !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL,
    Floor_tile_Mat,           !- Name
    Smooth,                   !- Roughness
    0.02,                     !- Thickness
    1,                        !- Conductivity
    2000,                     !- Density
    800,                      !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL,
    Roof_wood_Mat,            !- Name
    MediumSmooth,             !- Roughness
    0.05,                     !- Thickness
    0.15,                     !- Conductivity
    600,                      !- Density
    1600,                     !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL,
    Floor_wood_Mat,           !- Name
    MediumSmooth,             !- Roughness
    0.05,                     !- Thickness
    0.15,                     !- Conductivity
    600,                      !- Density
    1600,                     !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL,
    Wall_brick_Mat,           !- Name
    MediumRough,              !- Roughness
    0.2,                      !- Thickness
    0.8,                      !- Conductivity
    1900,                     !- Density
    800,                      !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL,
    Roof_generic_Mat,         !- Name
    MediumRough,              !- Roughness
    0.2,                      !- Thickness
    1.13,                     !- Conductivity
    1400,                     !- Density
    1000,                     !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL,
    Floor_generic_Mat,        !- Name
    MediumRough,              !- Roughness
    0.2,                      !- Thickness
    1.13,                     !- Conductivity
    1400,                     !- Density
    1000,                     !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

CONSTRUCTION,
    Wall_plaster_Constr,      !- Name
    Wall_plaster_Mat;         !- Outside Layer

CONSTRUCTION,
    Roof_tile_Constr,         !- Name
    Roof_tile_Mat;            !- Outside Layer

CONSTRUCTION,
    Floor_tile_Constr,        !- Name
    Floor_tile_Mat;           !- Outside Layer

CONSTRUCTION,
    Roof_wood_Constr,         !- Name
    Roof_wood_Mat;            !- Outside Layer

CONSTRUCTION,
    Floor_wood_Constr,        !- Name
    Floor_wood_Mat;           !- Outside Layer

CONSTRUCTION,
    Wall_brick_Constr,        !- Name
    Wall_brick_Mat;           !- Outside Layer

CONSTRUCTION,
    Roof_generic_Constr,      !- Name
    Roof_generic_Mat;         !- Outside Layer

CONSTRUCTION,
    Floor_generic_Constr,     !- Name
    Floor_generic_Mat;        !- Outside Layer

GLOBALGEOMETRYRULES,
    UpperLeftCorner,          !- Starting Vertex Position
    CounterClockWise,         !- Vertex Entry Direction
    World,                    !- Coordinate System
    Relative,                 !- Daylighting Reference Point Coordinate System
    Relative;                 !- Rectangular Surface Coordinate System

